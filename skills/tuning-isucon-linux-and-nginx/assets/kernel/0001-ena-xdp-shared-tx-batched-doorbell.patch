+/* When true, XDP_TX/ndo_xdp_xmit use the regular Tx rings (serialized with
+ * the stack via the netdev Tx queue lock) instead of dedicated XDP Tx queues,
+ * so XDP does not require halving the channel count.
+ */
+extern bool ena_xdp_shared_tx;
+
 static inline bool ena_xdp_legal_queue_count(struct ena_adapter *adapter,
 					     u32 queues)
 {
-	return 2 * queues <= adapter->max_num_io_queues;
+	return ena_xdp_shared_tx || 2 * queues <= adapter->max_num_io_queues;
+}
+
+/* Lock protecting the Tx ring used for XDP transmission */
+static inline void ena_xdp_tx_lock(struct ena_ring *tx_ring)
+{
+	if (ena_xdp_shared_tx)
+		__netif_tx_lock(netdev_get_tx_queue(tx_ring->netdev, tx_ring->qid),
+				smp_processor_id());
+	else
+		spin_lock(&tx_ring->xdp_tx_lock);
+}
+
+static inline void ena_xdp_tx_unlock(struct ena_ring *tx_ring)
+{
+	if (ena_xdp_shared_tx)
+		__netif_tx_unlock(netdev_get_tx_queue(tx_ring->netdev, tx_ring->qid));
+	else
+		spin_unlock(&tx_ring->xdp_tx_lock);
+}
+
+/* Ring the doorbell once for all XDP_TX frames queued during a NAPI poll */
+static inline void ena_xdp_tx_flush(struct ena_ring *tx_ring)
+{
+	ena_xdp_tx_lock(tx_ring);
+	ena_ring_tx_doorbell(tx_ring);
+	ena_xdp_tx_unlock(tx_ring);
 }
 
